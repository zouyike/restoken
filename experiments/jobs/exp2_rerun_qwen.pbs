#!/bin/bash
#SBATCH --job-name=w2_1
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --gres=gpu:2
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=06:00:00
#SBATCH --output=/scratch/genesis/NCAA_tokenization/experiments/jobs/exp2_rerun_qwen.out
#SBATCH --error=/scratch/genesis/NCAA_tokenization/experiments/jobs/exp2_rerun_qwen.err

source ~/.bashrc
conda activate ai

export PYTHONPATH=/scratch/genesis/NCAA_tokenization
export HF_HOME=/public/home/genesis/.cache/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false

echo "Job started: $(date)"
echo "Node: $(hostname)"
echo "GPUs: $(nvidia-smi -L 2>/dev/null | wc -l)"

# Back up old results before overwriting
OUTDIR=/scratch/genesis/NCAA_tokenization/experiments/output/exp2_controllability
for f in Qwen3.5-9B_exp2_controllability_raw.json Qwen3.5-9B_exp2_controllability_results.json Qwen3.5-9B_exp2_controllability_summary.json; do
    if [ -f "$OUTDIR/$f" ]; then
        cp "$OUTDIR/$f" "$OUTDIR/${f%.json}_old.json"
    fi
done

echo ">>> Exp2: controllability (Qwen3.5-9B)"
/public/home/genesis/miniconda3/envs/ai/bin/python \
    /scratch/genesis/NCAA_tokenization/experiments/script/run_benchmark.py \
    --experiment exp2 --backend hf \
    --model unsloth/Qwen3.5-9B \
    --representation restoken \
    --n_parents 10 \
    --n_variants 20

echo "Job finished: $(date)"
